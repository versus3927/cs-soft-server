# Мост-сервер cs-soft (Node) — ставится рядом с CS2 в том же compose.
# Нужен, чтобы плагин получал раздачу софтов по раундам.
FROM node:22-alpine

WORKDIR /app

# сначала только манифесты — слой с зависимостями кэшируется
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# исходники моста: серверная часть + статика (её можно открыть в браузере)
COPY server ./server
COPY public ./public

ENV PORT=3000 HOST=0.0.0.0
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD wget -qO- http://127.0.0.1:3000/health || exit 1

CMD ["node", "server/index.js"]

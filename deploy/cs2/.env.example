# ─────────────────────────────────────────────────────────────
#  Настройки CS2-сервера. Скопируй в .env и правь под себя:
#     cp .env.example .env
#  ВАЖНО: .env содержит GSLT-токен — не коммить его.
# ─────────────────────────────────────────────────────────────

# GSLT-токен (обязателен для публичного сервера).
# Взять: https://steamcommunity.com/dev/managegameservers → App ID 730
SRCDS_TOKEN="ВСТАВЬ_СВОЙ_ТОКЕН"

# Имя сервера в браузере
CS2_SERVERNAME="CS2 SOFT SERVER | рандомный софт каждый раунд"

# Порт (если меняешь — поменяй и в docker-compose.yml)
CS2_PORT=27015

# Пароль на вход. Пусто = сервер открытый
CS2_PW=""

# Пароль RCON (админка). Обязательно смени!
CS2_RCONPW="смени_этот_пароль"

# Слоты
CS2_MAXPLAYERS=12

# 0 = интернет, 1 = только LAN
CS2_LAN=0

# Читы (sv_cheats). Для обычной игры 0.
CS2_CHEATS=0

# Не усыплять сервер (усыпление иногда роняет CS2)
CS2_SERVER_HIBERNATE=0

# SourceTV / GOTV
TV_ENABLE=1
TV_PORT=27020
TV_AUTORECORD=0

# Режим: competitive = game_type 0 / game_mode 1
# (casual 0/0, wingman 0/2, deathmatch 1/2)
CS2_GAMEALIAS=competitive

# Стартовая карта
CS2_STARTMAP=de_dust2
CS2_MAPGROUP=mg_active

# Любые дополнительные параметры запуска
CS2_ADDITIONAL_ARGS=""

# Подробность логов образа: 0 нет, 1 steamcmd, 2 cs2, 3 всё
DEBUG=0

# ─────────────────────────────────────────────────────────────
#  Мост cs-soft (Node) — раздаёт софты плагину CS2
# ─────────────────────────────────────────────────────────────

# Секретный токен моста. Плагин обязан прислать его в заголовке X-Rounds-Token.
# Сгенерировать: openssl rand -hex 24
ROUNDS_TOKEN="сгенерируй_openssl_rand_hex_24"

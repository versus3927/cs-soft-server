# ─────────────────────────────────────────────────────────────
#  CS SOFT SERVER — все переменные окружения.
#  Скопируй в .env и раскомментируй нужное:  cp .env.example .env
#  Все переменные опциональны. Без .env сервер работает на дефолтах.
# ─────────────────────────────────────────────────────────────

# ── Сервер ───────────────────────────────────────────────────
# Порт HTTP. Дефолт: 3000. На Render/Railway/Fly НЕ задавай —
# хостинг подставит свой PORT сам и проксирует на него трафик.
#PORT=3000

# Адрес прослушивания. Дефолт: 0.0.0.0 (нужен и локально, и для превью).
# Менять на 127.0.0.1 можно только если сервер стоит за nginx на той же машине.
#HOST=0.0.0.0

# ── Раунды ───────────────────────────────────────────────────
# Длительность раунда в секундах. Дефолт: 60. Диапазон 10..3600.
#ROUND_TIME=60

# Перерыв между раундами в секундах (таблица итогов + новый дроп). Дефолт: 8. Диапазон 2..300.
#INTERMISSION=8

# ── Игроки и дроп ────────────────────────────────────────────
# Максимум подключений. Дефолт: 16. Диапазон 2..64.
#MAX_PLAYERS=16

# Шанс «двойного дропа» (два софта сразу). Дефолт: 0.15. Диапазон 0..1.
#DOUBLE_SOFT_CHANCE=0.15

# Ник, который сервер подставит первым подключившимся (если свободен). Дефолт: пусто.
#PLAYER_NAME=

# ── Безопасность ─────────────────────────────────────────────
# Origin для socket.io. Дефолт: * (играть можно с любого адреса).
# Если сервер публичный и нужен только твой домен:
#ALLOWED_ORIGIN=https://cs-soft.example.com
